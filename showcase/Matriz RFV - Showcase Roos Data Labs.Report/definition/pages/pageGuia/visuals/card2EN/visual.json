    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "2. RELATIONSHIP & CROSS-FILTERING",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#1D4ED8"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\nWhy didn't bubble clicks filter the customer table before?",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt",
                      "color": "#EA580C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\nFor matrix bubble selection to filter your customer table, cards, and charts, both tables MUST be linked by a relationship in the Semantic Model.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#334155"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\n\nStep-by-Step Setup:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\n1. In your Customers (or Sales Fact) table, create the key column:\n   ChaveRFM = dClientes[Recencia] * 10 + dClientes[Frequencia/Monetario]",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#475569"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\n\n2. In Power BI Model View, drag ChaveRFM from dClientes to #MatrizRFM[ChaveRFM].",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#475569"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\n\n3. Cardinality: Many to One (*:1)",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9.5pt",
                      "color": "#1D4ED8"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\n   • dClientes (Many / *) -> #MatrizRFM (One / 1 unique key)",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#475569"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\n\n4. Cross-Filter Direction: Both",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9.5pt",
                      "color": "#1D4ED8"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\n   With bidirectional filtering active, selecting any bubble or quadrant instantly filters your client list and executive KPIs!",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#16A34A",
                      "fontWeight": "600"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  },
