        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "1. CONSTRUCCIÓN DE LA TABLA #MatrizRFM",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#1D4ED8"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\nEl visual requiere una tabla dimensional con las 25 celdas de la matriz (5x5). Cada fila representa una coordenada de Recencia y Frecuencia/Valor.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#334155"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\n\nColumnas Requeridas:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\n• Recencia (1 a 5): Eje X de la matriz\n• Frequencia/Monetario (1 a 5): Eje Y de la matriz\n• ChaveRFM (int64): Recencia * 10 + [Frequencia/Monetario]\n• Descricao (Texto): Nombre del cluster (ej: Campeones, En Riesgo)\n• Descricao EN / Descricao ES: Nombres traducidos\n• Ordem (int64): Orden lógico de las clases",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#475569"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\n\nCódigo Power Query (M) Listo:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\nlet\n    Fuente = Table.FromRows({\n        {5, 5, 55, \"Campeones\", \"Champions\", \"Campeones\", 11},\n        {4, 5, 45, \"Clientes Leales\", \"Loyal Customers\", \"Clientes Leales\", 10},\n        ...\n        {1, 1, 11, \"Perdidos\", \"Lost\", \"Perdidos\", 1}\n    }, type table [Recencia=Int64.Type, #\"Frequencia/Monetario\"=Int64.Type, ...])\nin\n    Fuente",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A",
                      "fontFamily": "'Consolas', monospace"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\n\n💡 Sugerencia:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9.5pt",
                      "color": "#EA580C"
                    }
                  },
                  {
                    "value": " También puedes crear esta tabla en DAX con DATATABLE().",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#475569"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
