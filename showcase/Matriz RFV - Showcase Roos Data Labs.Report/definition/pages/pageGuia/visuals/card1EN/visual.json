          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "1. BUILDING THE #MatrizRFM TABLE",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#1D4ED8"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\nThe visual requires a dimension table representing the 25 matrix cells (5x5). Each row corresponds to a Recency and Frequency/Monetary score.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#334155"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\n\nRequired Columns:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\n• Recencia (1 to 5): X-Axis position\n• Frequencia/Monetario (1 to 5): Y-Axis position\n• ChaveRFM (int64): Recencia * 10 + [Frequencia/Monetario]\n• Descricao (Text): Cluster name (e.g. Champions, At Risk)\n• Descricao EN / Descricao ES: Multi-language descriptions\n• Ordem (int64): Logical sort order",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#475569"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\n\nPower Query (M) Code Snippet:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\nlet\n    Source = Table.FromRows({\n        {5, 5, 55, \"Champions\", \"Champions\", \"Campeones\", 11},\n        {4, 5, 45, \"Loyal Customers\", \"Loyal Customers\", \"Clientes Leales\", 10},\n        ...\n        {1, 1, 11, \"Lost\", \"Lost\", \"Perdidos\", 1}\n    }, type table [Recencia=Int64.Type, #\"Frequencia/Monetario\"=Int64.Type, ...])\nin\n    Source",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A",
                      "fontFamily": "'Consolas', monospace"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\n\n💡 Pro Tip:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9.5pt",
                      "color": "#EA580C"
                    }
                  },
                  {
                    "value": " You can also generate this table via DAX using DATATABLE().",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#475569"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
