                  {
                    "value": "3. DAX MEASURES & ADVANCED CAPABILITIES",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#1D4ED8"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\nRecommended DAX Measures:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\n• Customer Count:\n   Customer Count = COUNTROWS(dClientes)\n\n• Total Revenue:\n   Total Revenue = SUM(dClientes[Faturamento])\n\n• Average Ticket:\n   Average Ticket = DIVIDE([Total Revenue], [Total Orders])",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A",
                      "fontFamily": "'Consolas', monospace"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\n\nVisual Field Mapping:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\n• Recency (X-Axis): #MatrizRFM[Recencia]\n• Frequency / Monetary (Y-Axis): #MatrizRFM[Frequencia/Monetario]\n• Values (Metric): [Customer Count]\n• Tooltips: [Total Revenue], [Average Ticket]\n• Small Multiples (Optional): dClientes[Segmento]",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#475569"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\n\nExclusive Roos Data Labs Features:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt",
                      "color": "#1D4ED8"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\n• Native Small Multiples with unified global bubble scaling\n• Focus Mode button to expand and fill visual canvas\n• Ultra-premium dark tooltip with custom metrics & formats\n• 3-language labels switchable in the Format Pane (PT, EN, ES)",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#334155"
                    }
                  }
                ]
              }
