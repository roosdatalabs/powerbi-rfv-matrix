model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["dClientes","#MatrizRFM"]

annotation PBI_ProTooling = ["DevMode"]

ref table dClientes
ref table #MatrizRFM
ref table Medidas

ref cultureInfo pt-BR

